# Environment variables example for Creative AI Marketing Platform
# Copy this file to .env and provide your credentials.
# NEVER commit .env to version control.

# --- Supabase (PostgreSQL, Auth, RLS, Storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Stability AI (Primary Image Generation Provider) ---
STABILITY_API_KEY=

# --- Anthropic Claude (Primary Text Generation Provider) ---
ANTHROPIC_API_KEY=

# --- Google Gemini (Image Fallback Provider) ---
GEMINI_API_KEY=

# --- App URL ---
APP_URL=
